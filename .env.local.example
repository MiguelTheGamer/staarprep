# ─────────────────────────────────────────────────────────────
# StarPrep AI - Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
# ─────────────────────────────────────────────────────────────

# Anthropic API key, server-side ONLY. Never expose to the client.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for question generation. Sonnet is the cost/quality sweet spot.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Supabase, project URL and keys from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key

# Service-role key, server-side ONLY (used for admin operations, bypasses RLS).
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...your-service-role-key

# PRIVATE DEPLOY: comma-separated list of emails allowed to sign in.
# Leave EMPTY for open multi-tenant access. Set to your email to lock down
# the deployment to just you.
# Example: ALLOWED_EMAILS=miguel@example.com,backup@example.com
ALLOWED_EMAILS=

# Stripe (Phase 2, billing). Leave blank until you wire up payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEACHER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App URL (used for auth redirects). In production set to your Vercel domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily generation caps. Optional. Defaults: 100 per user per day, 2000
# across all users per day. These are HARD ceilings to protect your
# Anthropic bill. Reset at 00:00 UTC.
DAILY_USER_CAP=100
DAILY_GLOBAL_CAP=2000
